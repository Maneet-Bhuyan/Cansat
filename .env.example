# ==============================================================================
# Cognitive CanSat Mission Control & AI Ground Station - Environment Config
# Copy this file to .env and adjust parameters for your deployment environment.
# ==============================================================================

# Server Network Configuration
PORT=8000
CANSAT_ALLOWED_ORIGINS=*

# Hardware Dual-Serial Bridge (Telemetry Receiver + Video/Camera Receiver)
CANSAT_TELEMETRY_PORT=COM4
CANSAT_TELEMETRY_BAUD=9600
CANSAT_VIDEO_PORT=COM5
CANSAT_VIDEO_BAUD=460800

# SQLite Local WAL Database
CANSAT_DB_PATH=data/cansat_missions.db

# Optional Distributed Telemetry Lakehouse (Redpanda / TimescaleDB / MinIO)
REDPANDA_BROKER=localhost:19092
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telemetry_db
DB_USER=cansat_admin
DB_PASS=cansat_password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
