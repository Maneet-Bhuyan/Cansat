      "id": 1,
      "title": "Current Altitude",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "rawSql": "SELECT time, altitude_m FROM raw_telemetry ORDER BY time DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 },
              { "color": "orange", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Vertical Velocity (Δh/Δt)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "rawSql": "SELECT time, velocity_mps FROM raw_telemetry ORDER BY time DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -15 },
              { "color": "green", "value": -8 },
              { "color": "blue", "value": 0 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
